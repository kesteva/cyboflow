# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
# /build/* (not build/) so the negations below can work — git cannot re-include
# files under an excluded DIRECTORY. The electron-builder hooks + their tests
# are SOURCE, not build output; without these negations a plain `git add`
# silently skips them (afterSign.js was historically force-added; a fresh clone
# missing verifyArtifact.js would fail the build resolving the registered
# artifactBuildCompleted hook).
/build/*
!/build/entitlements.mac.plist
!/build/afterSign.js
!/build/afterSign.test.js
!/build/verifyArtifact.js
!/build/verifyArtifact.test.js
*.tsbuildinfo
dist-electron/
main/dist/
frontend/dist/
backend/dist/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.envrc
.envrc.local

# OS
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/

# Cached better-sqlite3 native artifacts, one per ABI (scripts/ensure-sqlite-abi.mjs).
# Machine-specific compiled output — rebuilt on demand, never shared.
.abi-cache/

# Git worktrees (except the main directory)
/worktree-*/
/worktrees/
.worktrees/

# Claude Code session data
sessions/
.claude-sessions/
.claude-images/

# Electron
*.dmg
*.zip
*.app
*.exe
*.deb
*.AppImage
*.snap
*.pacman
electron-builder.yml
electron-builder.json5
build/electron-builder.generated.json

# Electron Builder directories
packaged/
release/

# Keep project-scoped Claude skills tracked (the broad release/ ignore above
# would otherwise swallow .claude/skills/release/ and any future skill dirs).
!.claude/skills/
!.claude/skills/**

# Local development
.ccc/
*.sqlite
*.sqlite3
*.db-journal

# Database files
main/crystal.db
main/*.db

# Test results and reports
test-results/
playwright-report/
test-report/
.playwright-mcp/
smoke-test.png

# Temporary test files
test-file.txt
*.test.tmp

# Pre-rewrite backups
*.backup

# Crystal user data directory (if accidentally placed in repo)
.crystal/

# Generated TypeScript files
frontend/vite.config.d.ts

# Generated files
# Shared build artifacts
shared/*.js
shared/*.js.map
shared/*.d.ts
shared/*.d.ts.map
.cyboflow/worktrees/
frontend/dist-harness/

# Perf profiling artifacts (scripts/profile-electron.mjs)
.perf/
